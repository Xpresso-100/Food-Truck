# Food Truck - environment variables (SPEC section 7). PLACEHOLDERS ONLY.
#
# The app never reads a .env file. Set these as real environment variables on the server,
# or put them in a gitignored config.local.php at the repo root that returns an array, e.g.
#   <?php return ['DB_DSN' => '...', 'DB_USER' => '...'];
# config.local.php only fills variables the environment has not already set.

# production | dev | test   (unset = production)
APP_ENV=production

# MySQL in production (own database, never xpresso_clients); sqlite:/path/app.sqlite for dev
DB_DSN=mysql:host=localhost;dbname=xpresso_truck;charset=utf8mb4
DB_USER=COPY_FROM_LIVE_FILE
DB_PASS=COPY_FROM_LIVE_FILE

# 1 (default) = Secure cookie. 0 only for local http
SESSION_COOKIE_SECURE=1
# Session file directory. Empty = PHP default
SESSION_SAVE_PATH=

# tunnel (production) | mock (tests and dev)
FINCON_ADAPTER=tunnel
# Cloudflare Tunnel hostname - see the reference FINCON_TUNNEL_RUNBOOK.md section 3. Never commit it.
FINCON_BASE_URL=https://fincon-tunnel.example.invalid
# Cloudflare Access service-token pair
FINCON_CF_CLIENT_ID=COPY_FROM_LIVE_FILE
FINCON_CF_CLIENT_SECRET=COPY_FROM_LIVE_FILE
# FinCon server HTTP Basic credentials
FINCON_SRV_USER=COPY_FROM_LIVE_FILE
FINCON_SRV_PASS=COPY_FROM_LIVE_FILE
# FinCon Login _parameters
FINCON_DATA_ID=COPY_FROM_LIVE_FILE
FINCON_USER=COPY_FROM_LIVE_FILE
FINCON_PASS=COPY_FROM_LIVE_FILE

# Mock adapter only
FINCON_MOCK_STOCK=
FINCON_MOCK_LOG=

# Seconds. 0 disables the stock cache
STOCK_CACHE_TTL_SECONDS=900
STOCK_THRESHOLD_LOW=10
